# 复制为 .env 后再启动。不要提交真实密钥。
TZ=Asia/Shanghai
WEB_BIND=0.0.0.0
WEB_PORT=80

# 必须修改：可用 `openssl rand -hex 24` 分别生成。
MONGODB_USERNAME=admin
MONGODB_PASSWORD=CHANGE_ME_MONGODB_PASSWORD
MONGODB_DATABASE=tradingagents
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
CSRF_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_EMAIL=admin@localhost

# 至少配置一个模型供应商。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ENABLED=false
DASHSCOPE_API_KEY=
DASHSCOPE_ENABLED=false
OPENAI_API_KEY=
OPENAI_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_ENABLED=false

# 数据源：AKShare 无需密钥；Tushare / FinnHub 按需填写。
DEFAULT_CHINA_DATA_SOURCE=akshare
TUSHARE_TOKEN=
TUSHARE_ENABLED=false
FINNHUB_API_KEY=

# 个人服务器推荐配置。
DEBUG=false
MEMORY_ENABLED=false
ONLINE_TOOLS_ENABLED=false
DEFAULT_USER_CONCURRENT_LIMIT=1
GLOBAL_CONCURRENT_LIMIT=1
MONGO_MAX_CONNECTIONS=10
MONGO_MIN_CONNECTIONS=0
REDIS_MAX_CONNECTIONS=10
TRADINGAGENTS_LOG_LEVEL=INFO
NO_PROXY=localhost,127.0.0.1,mongodb,redis,eastmoney.com,push2.eastmoney.com,api.tushare.pro,baostock.com
